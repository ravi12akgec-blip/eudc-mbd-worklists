rules_version = '2';
// EUDC MBD Work Lists — Storage security rules (consumer master data).
// Paste into Firebase console → Storage → Rules → Publish.
service firebase.storage {
  match /b/{bucket}/o {
    function profile() { return firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data; }
    function approved() { return request.auth != null && profile().status == 'approved'; }
    function office() { return approved() && profile().role in ['admin', 'office']; }
    match /master/{file=**} {
      allow read: if approved();
      allow write: if office();
    }
  }
}
